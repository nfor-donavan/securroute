MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/securroute
JWT_SECRET=change-me
PORT=5000
ADMIN_NAME=Administrator
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Web portal URL, used to build the password-reset link in emails
FRONTEND_URL=https://your-web.onrender.com

# Gmail SMTP (free) for password-reset emails.
# Use a Gmail Account -> Security -> 2-Step Verification -> App Passwords (16 characters, no spaces).
# Do NOT use your normal Gmail password here.
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your-16-char-app-password
